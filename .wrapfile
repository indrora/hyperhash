name: hyperhash
nameTemplate: "{{.Name}}-{{.Target}}-{{.Version}}-{{.OS}}-{{.Arch}}"
targets:
  default:
    package: github.com/indrora/hyperhash
    platforms:
    - linux/arm64
    - linux/amd64
    - darwin/arm64
    - darwin/amd64
    - windows/arm64
    - windows/amd64
    - windows/386
    - linux/386
  insecure:
    package: github.com/indrora/hyperhash
    platforms:
    - linux/arm64
    - linux/amd64
    - darwin/arm64
    - darwin/amd64
    - windows/arm64
    - windows/amd64
    - windows/386
    - linux/386
    tags:
      - insecure
